rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        request.auth.token.email == 'zeroxendet@gmail.com'
      );
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Staff subcollections strictly protected by owner identity
      match /staff/{staffId} {
        allow read, write: if isOwner(userId);
      }

      match /activity_log/{activityId} {
        allow read, write: if isOwner(userId);
      }

      match /correction_requests/{requestId} {
        allow read, write: if isOwner(userId);
      }

      match /{allChildren=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}

